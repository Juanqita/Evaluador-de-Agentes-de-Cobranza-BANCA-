# .env.example — plantilla. Copiar a .env para desarrollo LOCAL únicamente.
# .env NUNCA debe commitearse (ver .gitignore) ni subirse a la imagen Docker.
# En Render/Railway/Fly.io, GEMINI_API_KEY se configura como "secret env var"
# en el dashboard de la plataforma, no en este archivo ni en el repo.

GEMINI_API_KEY=
GEMINI_CLIENT_MODE=real
